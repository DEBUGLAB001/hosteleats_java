      "test": "testRejectedRequestDoesNotExtendLimitWindow"
    },
    {
      "id": 3,
      "name": "Rush Hour Analytics Omits Final Peak Window",
      "file": "src/main/java/com/hosteleats/service/AnalyticsService.java",
      "test": "testPeakWindowIncludesFinalValidStart"
    },
    {
      "id": 4,
      "name": "Campus Walk Suboptimal Path Calculation",
      "file": "src/main/java/com/hosteleats/service/CampusService.java",
      "test": "testRouteDistanceIncludesFullPath"
    },
    {
      "id": 5,
      "name": "Combo Builder Unbounded Duplicate Items",
      "file": "src/main/java/com/hosteleats/service/ComboService.java",
      "test": "testComboUsesEachMenuItemOnce"
    },
    {
      "id": 6,
      "name": "Overlapping Pickup Slot Shrinkage",
